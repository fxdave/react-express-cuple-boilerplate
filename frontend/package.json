{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "type-check": "tsc",
    "format": "biome format --write ./src"
  },
  "dependencies": {
    "@cuple/client": "^2.3.1",
    "@cuple/react": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-compression": "^0.5.1"
  }
}
